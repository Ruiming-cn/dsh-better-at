{
  "name": "dsh-better-at",
  "version": "0.1.0",
  "description": "Fast @ file/session reference caching for the DeepSeek Harness Web GUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruiming-cn/dsh-better-at.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "at-menu",
    "file-reference",
    "session-reference",
    "performance"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-file-reference": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-session-query": { "optional": true },
    "@deepseek-ai/dsh-typert-registry": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-api-remotes": { "optional": true },
    "@deepseek-ai/dsh-client-ui-input-trigger": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-file-reference": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
